# Copy this file to .env and adjust as needed before running docker-compose.

# --- Postgres ---
POSTGRES_DB=answer_eval
POSTGRES_USER=aes_user
POSTGRES_PASSWORD=aes_password

# --- Backend ---
JWT_SECRET=change-me-to-a-long-random-string-in-production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080
